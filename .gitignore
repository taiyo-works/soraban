# 大容量の規制データ（再生成可能）
packages/regulations/data/did/raw/
packages/regulations/data/.fetch-work/
packages/regulations/data/.fetch-work-address/
packages/regulations/data/did/by-pref/
packages/regulations/data/did/all.geojson
packages/regulations/data/airports/raw/
# airports.geojson は Phase 0/1 では手描き seed (山陰 + 但馬 6 空港) を直接 track。
# Phase 1 後半で fetch-airports.sh による C28-20 正規データに置換した時点で、
# データサイズに応じて再度 ignore するか検討する。
packages/regulations/data/parks/raw/
# OSM 生取得データ (fetch-parks-osm.mjs で再生成可能、マージ前の中間成果物)
packages/regulations/data/parks/by-muni-osm/
# マージ前のハンドメイド版バックアップ (git 履歴に残っているので不要)
packages/regulations/data/parks/by-muni-handdrawn-backup/

# ローカル作業で生成され得る一時データコピー (コミット対象外)
apps/web/regulation-data/

# ローカル作業用アーカイブ
files.zip

# QA・デザイン検証で生成されるスクラッチ（スクショ/PDF/Playwright 出力。再生成可能）
.designer-shots/
.playwright-mcp/
# evaluator が一時生成する検証アーティファクト（リポジトリ直下）
/eval-*.png
/eval-*.jpeg
/eval-*.pdf
/eval-*.txt

# Claude Code local config
.claude/
.vercel

# Playwright
test-results/
playwright-report/
playwright-report-ops/
