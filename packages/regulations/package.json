{
  "name": "@soraban/regulations",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./address": "./src/address/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fetch:did": "bash scripts/fetch-did.sh",
    "fetch:airports": "bash scripts/fetch-airports.sh",
    "fetch:parks": "bash scripts/fetch-parks.sh",
    "fetch:all": "bash scripts/fetch-did.sh && bash scripts/fetch-airports.sh && bash scripts/fetch-parks.sh",
    "fetch:address": "node scripts/fetch-address-data.mjs"
  },
  "dependencies": {
    "@soraban/geo": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
