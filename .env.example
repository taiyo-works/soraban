# --- データベース（Neon / PostgreSQL 18 + PostGIS）---------------------------
# 値（接続文字列）はリポジトリに置かない。本番の値は Vercel の環境変数にだけ置く。
# 詳しくは packages/db/README.md。
#
# アプリ用（プール経由）。Neon の Pooled connection（ホスト名に -pooler を含む）。
# 未設定なら DB に接続せず、地点判定・申請支援は DB なしで動く（証跡は記録しない）。
DATABASE_URL=
# マイグレーション用（直結）。Neon の Direct connection。pnpm db:migrate / db:status だけが使う。
# アプリ（Vercel）には設定しない。実行する人の手元のシェルでだけ設定する。
DATABASE_URL_UNPOOLED=
# 証跡（evidence_log）の書き込みを止めるときだけ off にする。
EVIDENCE_LOG=

GEMINI_API_KEY=
GSI_API_BASE=https://msearch.gsi.go.jp/
ANTHROPIC_API_KEY=

# --- 運航管理（Sprint 10。利用者・機体・操縦者）-------------------------------
# 既定は無効（未設定）。1 にすると /ops と /api/ops を出す。本番の準備（packages/db/README.md
# 「運航管理（Sprint 10）の本番準備」）が済むまで本番では設定しない。値はリポジトリに置かない。
OPS_ENABLED=
# 本人確認の方式：neon（本番。Neon Auth）／test（CI・E2E・ローカル専用。本番では使えない）
AUTH_PROVIDER=
# Neon Auth の Auth URL と、セッション Cookie の署名用の秘密（32 文字以上。openssl rand -base64 32）
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# AUTH_PROVIDER=test のときの Cookie の署名用の秘密（ローカル・CI だけ。本番に設定しない）
AUTH_TEST_SECRET=

# --- 通報ゲートウェイ（Sprint 12b。DIPS 2.0 の飛行計画の通報）-----------------------
# 通報の記録の方式：manual（既定。利用者が DIPS で通報した結果を記録する。そらばんは DIPS に送信しない）／
# mock（開発・CI・E2E 専用の模擬。実際の DIPS には送信されない。VERCEL_ENV が production・preview のときは拒否される）。
# api と未知の値は設定の誤りとして 503 adapter_unavailable になる（手動へは自動で落とさない）。値はここに書かない。
DIPS_REPORT_ADAPTER=
