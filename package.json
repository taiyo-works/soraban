{
  "name": "soraban",
  "version": "0.0.0",
  "private": true,
  "description": "そらばん（Soraban）山陰の業務ドローン運用者向けコンプライアンス統合SaaS。",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @soraban/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:status": "tsx packages/db/src/cli.ts status",
    "db:seed:ops-test": "tsx packages/db/src/ops-seed-cli.ts",
    "test:e2e:ops": "playwright test --config playwright.ops.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^4.1.5",
    "pdfjs-dist": "^5.4.296",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
